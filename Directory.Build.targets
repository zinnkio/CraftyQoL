<Project>
  <ItemGroup Condition="'$(IsValheimPlugin)' == 'true'">
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(GameManaged)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(GameManaged)\assembly_guiutils.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(GameManaged)\assembly_utils.dll" Private="false" />
    <Reference Include="gui_framework" HintPath="$(GameManaged)\gui_framework.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameManaged)\UnityEngine.AnimationModule.dll" Private="false" />
    <!-- UIVertex lives in this already-shipped Unity module; never copy game modules to output. -->
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences" Condition="'$(IsValheimPlugin)' == 'true'">
    <Error Condition="!Exists('$(GameManaged)\assembly_valheim.dll')" Text="Set ValheimRoot in ignored Environment.props or with -p:ValheimRoot to a local client installation." />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll') or !Exists('$(BepInExCore)\0Harmony.dll')" Text="BepInEx/Harmony references missing. Set BepInExCore or acquire the pinned pack; see docs/DEVELOPMENT_ENVIRONMENT.md." />
  </Target>
</Project>
